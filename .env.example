# Site
NEXT_PUBLIC_SITE_URL=https://havs.dev
DEFAULT_CURRENCY=USD

# Supabase (orders + private file storage). Run supabase/schema.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PLANS_BUCKET=plans-private

# Signs download links (any long random string)
DOWNLOAD_SECRET=

# Admin (marks bank-transfer orders paid). Send as Bearer token.
ADMIN_TOKEN=

# Lemon Squeezy — merchant of record: cards, Apple Pay, Google Pay, PayPal. See docs/payments.md.
# Webhook: https://havs.dev/api/webhooks/lemonsqueezy (events order_created, order_refunded)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Crypto — NOWPayments (USDT, USDC, BTC, ETH, …). IPN: https://havs.dev/api/webhooks/crypto
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=

# Stripe (only for a business in a Stripe-supported country). Webhook: https://havs.dev/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Bank transfer instructions shown to the buyer (confirm a payment in Supabase: orders.status = paid)
BANK_TRANSFER_DETAILS=

# Shown on the contact page
CONTACT_EMAIL=
